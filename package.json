{
  "name": "bun",
  "private": true,
  "description": "Modern TypeScript repo powered by Bun",
  "homepage": "https://github.com/vprianikov/bun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vprianikov/bun.git"
