    "name": "Vasilii Prianikov",
    "email": "88191516+vprianikov@users.noreply.github.com"
  },
  "type": "module",
  "scripts": {
    "format:check": "bun run prettier --check .",
    "format:write": "bun run prettier --write .",
    "repo:check": "bun run lefthook run pre-commit --force",
    "repo:clean": "git clean -Xdf && rm -f bun.lock && bun install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@tsconfig/bun": "^1",
    "@types/bun": "^1",
    "lefthook": "^2",
    "prettier": "^3",
    "prettier-plugin-expand-json": "^1",
    "prettier-plugin-multiline-arrays": "^4",
    "prettier-plugin-packagejson": "^3",
    "prettier-plugin-sort-json": "^4"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
